{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "product-anniversary-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/productAnniversary/ProductAnniversaryWebPart.js",
